{
  "routes": {
    "/Workspace": {
      "loginRequired": true,
      "authz": [
        {
          "resource": "/workspace",
          "service": "jupyterhub",
          "method": "access"
        }
      ],
      "redirect403": "/WorkspaceRequestAccess"
    },
    "/Workspaces": {
      "loginRequired": true,
      "authz": [
        {
          "resource": "/workspace",
          "service": "jupyterhub",
          "method": "access"
        }
      ],
      "redirect403": "/WorkspaceRequestAccess"
    },
    "/WorkspaceRequestAccess": {
      "loginRequired": true,
      "authz": [
        {
          "resource": "/workspace",
          "service": "requestor",
          "method": "create"
        }
      ]
    },
    "*": {
      "loginRequired": true,
      "authz": ["/user-in-yaml"]
    }
  }
}
